{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Vite React (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/typetrail",
      "sourceMapPathOverrides": {
        "/*": "${webRoot}/*"
      },
      "breakOnLoad": true,
      "sourceMaps": true,
      "timeout": 30000,
      "preLaunchTask": "start-dev-server"
    }
  ]
}
